{
  "name": "fsdproject",
  "version": "1.0.0",
  "description": "Full-Stack Retail Store Billing & POS Software (College FSD Project)",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && mvnw.cmd spring-boot:run",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && mvnw.cmd clean package -DskipTests",
    "build:frontend": "cd frontend && npm run build",
    "test": "cd backend && mvnw.cmd test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
